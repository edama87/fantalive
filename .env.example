# FantaLive Bundlesliga - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# SUPABASE (Required for production)
# =============================================================================

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://kjbbapkvcutsxmpckeew.supabase.co

# Supabase publishable/anon key (public, safe to expose)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_s8FjmjAw3WQVx_BsVE1lcg_Q7P2P3tm

# Supabase service role key (SECRET - server only, never expose)
# Get this from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SECRET_KEY=

# =============================================================================
# LIVE DATA PROVIDER
# =============================================================================

# Provider selection: mock | espn
# Default: espn for production, mock for development
LIVE_PROVIDER=espn

# Also exposed to client for displaying provider info
NEXT_PUBLIC_LIVE_PROVIDER=espn

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Admin password for /admin routes (SECRET)
# Set this to protect the admin panel
ADMIN_PASSWORD=

# =============================================================================
# VERCEL CRON
# =============================================================================

# Cron job secret (auto-generated by Vercel, or set manually)
# Used to protect /api/cron/* routes
CRON_SECRET=

# =============================================================================
# FMS REVO INTEGRATION (Admin - Lineup Import)
# =============================================================================

# FMS Revo credentials for automatic lineup fetch (SECRET - server only)
# Used by /api/admin/lineups/fetch to login to bundlesliga.fmsrevo.it
FMSREVO_USERNAME=
FMSREVO_PASSWORD=

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Force local database (in-memory) instead of Supabase
# Set to 'true' for offline development
NEXT_PUBLIC_USE_LOCAL_DB=false
